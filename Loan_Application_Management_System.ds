		workflow
		{
		form
		{
			On_Application_Submit_Wor as "On_Application_Submit_Workflow"
			{
				type =  form
				form = loan_application

				record event = on add

				on success
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : email_address
							subject : "Record Added"
							message : "<div>${zoho.loginuserid} has added a record in form Loan Application<br></div>"
							content type : Plain Text
						)
					}
				}

			}
			Send_Email_Form_Propertie as "Send Email - Form Properties"
			{
				type =  presuccess
				form = loan_application
				on start
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : email_address
							subject : "Loan Application Management System : New entry added"
							message : "<div>Hello,<br><br>A new entry added in 'loan_application' form of Loan Application Management System application.<br></div>"
							content type : Plain Text
							attachments : template : _default1 as pdf
						)
					}
				}
			}
		}

		schedule
		{
			Daily_Pending_Document_Re as "Daily_Pending_Document_Reminder_Schedule"
			{
				type =  schedule
					status = inactive
				start = "2026-08-21 15:54:03"
				frequency = daily
				time zone = "America/Los_Angeles"
				on start
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : "zoho.adminuserid"
							subject : "REORT"
							message : "<div><br></div>"
							content type : Plain Text
							attachments : view : loan_application_Report as PDF
						)
					}
				}
			}
		}

		approval
		{
			HighValue_Loan_Approval as "HighValue_Loan_Approval"
			{
				type =  approval
				form = loan_application[loan_amount_requested <= 10000000]
				display fields = [applicant_name,date_of_birth,pan_number,email_address,contact_number,residential_address,employment_type]
				on start
				{
				}
				on level 1
				{
					on approve 
					{
						actions 
						{
							sendmail
							(
								from : zoho.loginuserid
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been approved."
							)
						}
					}
					on reject
					{

						actions 
						{
							sendmail
							(
								from : zoho.loginuserid
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been rejected."
							)
						}
					}
				}
			}
		}



