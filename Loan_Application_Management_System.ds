 application "Loan Application Management System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form branches
		{
			displayname = "Branches"
			success message = "Branches Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			branch_code
			(
    			type = text
				displayname = "Branch Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			branch_name
			(
    			type = text
				displayname = "Branch Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			ifsc_code
			(
    			type = text
				displayname = "IFSC Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			manager_name
			(
    			type = name
				displayname = "Manager Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			branch_address
			(
    			type = address
				displayname = "Branch Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
	     			 visibility = false
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
	     			 visibility = false
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
	     			 visibility = false
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
	     			 visibility = false
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			pincode
			(
    			type = text
				displayname = "Pincode"
	 			row = 1
	 			column = 1   
				width = medium
			)
			contact_number
			(
    			type = phonenumber
				displayname = "Contact Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			email_address
			(
    			type = email
				displayname = "Email Address"
	 			row = 1
	 			column = 1   
				width = medium
			)
			is_active
			(
    			type = checkbox
				displayname = "Is Active"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			created_date
			(
    			type = date
				displayname = "Created Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form co_applicant
		{
			displayname = "Co Applicant"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			loan_application
			(
				type = picklist	
				displayname = "Loan Application"
				values  = loan_application.ID
    			displayformat = [loan_application_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			co_applicant_name
			(
    			type = text
				displayname = "Co Applicant Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			relationship
			(
				type = picklist
				displayname = "Relationship"
				values = {"Spouse","Parent","Sibling","Child"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			monthly_income
			(
				type = number
				displayname = "Monthly Income"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form loan_application
		{
			displayname = "Loan Application"
			success message = "Loan Application Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			applicant_name
			(
    			type = name
				displayname = "Applicant Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			date_of_birth
			(
    			type = date
				displayname = "Date Of Birth"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			pan_number
			(
    			type = text
				displayname = "PAN Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			email_address
			(
    			type = email
				displayname = "Email Address"
	 			row = 1
	 			column = 1   
				width = medium
			)
			contact_number
			(
    			type = phonenumber
				displayname = "Contact Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			residential_address
			(
    			type = address
				displayname = "Residential Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
	     			 visibility = false
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
	     			 visibility = false
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
	     			 visibility = false
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
	     			 visibility = false
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			employment_type
			(
				type = radiobuttons
				displayname = "Employment Type"
				values = {"Self-Employed","Salaried"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			monthly_income
			(
				type = number
				displayname = "Monthly Income"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			existing_liabilities
			(
				type = list	
				displayname = "Existing Liabilities"
				values = {"Car Loan","Home Loan","Personal Loan","None","Credit Card Dues"}
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			loan_type
			(
				type = picklist
				displayname = "Loan Type"
				values = {"Vehicle Loan","Business Loan","Home Loan","Personal Loan"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			purpose_of_loan
			(
    			type = textarea
				displayname = "Purpose Of Loan"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			preferred_callback_time
			(
    			type = time
				displayname = "Preferred Callback Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			consent_for_credit_check
			(
    			type = checkbox
				displayname = "Consent For Credit Check"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			servicing_branch
			(
				type = picklist	
				displayname = "Servicing Branch"
				values  = branches.ID
    			displayformat = [branch_code]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			applicant_photo
			(
    			type = text
				displayname = "Applicant Photo"
	 			row = 1
	 			column = 1   
				width = medium
			)
			income_proof_upload
			(
    			type = text
				displayname = "Income Proof Upload"
	 			row = 1
	 			column = 1   
				width = medium
			)
			debt_to_income_ratio
			(
				type = decimal
				displayname = "Debt To Income Ratio"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			has_existing_loan_with_bank
			(
    			type = checkbox
				displayname = "Has Existing Loan With Bank"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			loan_amount_requested
			(
				displayname = "Loan Amount Requested"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			interest_rate_offered
			(
    			type = percentage
				displayname = "Interest Rate Offered"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			estimated_monthly_emi
			(
				type = decimal
				displayname = "Estimated Monthly EMI"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			loan_terms_display
			(
    			type = textarea
				displayname = "Loan Terms Display"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			applicant_digital_signature
			(
    			type = text
				displayname = "Applicant Digital Signature"
	 			row = 1
	 			column = 1   
				width = medium
			)
			application_submitted_on
			(
    			type = datetime
				displayname = "Application Submitted On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			loan_application_id
			(
    			type = text
				displayname = "Loan Application Id"
	 			row = 1
	 			column = 1   
				width = medium
			)
			application_tracking_qr_code
			(
    			type = text
				displayname = "Application Tracking QR Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = picklist
				displayname = "Status"
				values = {"Submitted","Credit Check","Document Verification","Disbursed","Approved","Rejected"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		list loan_application_Report
		{
			displayName = "All Loan Applications"
			show all rows from loan_application    
			(
				applicant_name  as "Applicant Name"
				date_of_birth as "Date Of Birth"
				pan_number as "PAN Number"
				email_address as "Email Address"
				contact_number as "Contact Number"
				residential_address  as "Residential Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				employment_type as "Employment Type"
				monthly_income as "Monthly Income"
				existing_liabilities as "Existing Liabilities"
				loan_type as "Loan Type"
				purpose_of_loan as "Purpose Of Loan"
				preferred_callback_time as "Preferred Callback Time"
				consent_for_credit_check as "Consent For Credit Check"
				servicing_branch as "Servicing Branch"
				applicant_photo as "Applicant Photo"
				income_proof_upload as "Income Proof Upload"
				debt_to_income_ratio as "Debt To Income Ratio"
				has_existing_loan_with_bank as "Has Existing Loan With Bank"
				loan_amount_requested as "Loan Amount Requested"
				(
					display = total,average,min,max	
				)
				interest_rate_offered as "Interest Rate Offered"
				(
					display = total,average,min,max	
				)
				estimated_monthly_emi as "Estimated Monthly EMI"
				loan_terms_display as "Loan Terms Display"
				applicant_digital_signature as "Applicant Digital Signature"
				application_submitted_on as "Application Submitted On"
				loan_application_id as "Loan Application Id"
				application_tracking_qr_code as "Application Tracking QR Code"
				status as "Status"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (loan_type == "Home Loan")
				fields = [loan_type]
				format = "color:#ffffff;background-color:#765f89;"
				}
			)
		}
		kanban loan_application_by_status
		{
			displayName = "Statuses"
			show all rows from loan_application    
			(
				applicant_name  as "Applicant Name"
				date_of_birth as "Date Of Birth"
				pan_number as "PAN Number"
				email_address as "Email Address"
				contact_number as "Contact Number"
				residential_address  as "Residential Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				employment_type as "Employment Type"
				monthly_income as "Monthly Income"
				existing_liabilities as "Existing Liabilities"
				loan_type as "Loan Type"
				purpose_of_loan as "Purpose Of Loan"
				preferred_callback_time as "Preferred Callback Time"
				consent_for_credit_check as "Consent For Credit Check"
				servicing_branch as "Servicing Branch"
				applicant_photo as "Applicant Photo"
				income_proof_upload as "Income Proof Upload"
				debt_to_income_ratio as "Debt To Income Ratio"
				has_existing_loan_with_bank as "Has Existing Loan With Bank"
				loan_amount_requested as "Loan Amount Requested"
				(
					display = total,average,min,max	
				)
				interest_rate_offered as "Interest Rate Offered"
				(
					display = total,average,min,max	
				)
				estimated_monthly_emi as "Estimated Monthly EMI"
				loan_terms_display as "Loan Terms Display"
				applicant_digital_signature as "Applicant Digital Signature"
				application_submitted_on as "Application Submitted On"
				loan_application_id as "Loan Application Id"
				application_tracking_qr_code as "Application Tracking QR Code"
				status as "Status"
			)
			options
			(
	 			display field = status
	 		)
		}
		list branches_Report
		{
			displayName = "All Branches"
			show all rows from branches    
			(
				branch_code as "Branch Code"
				branch_name as "Branch Name"
				ifsc_code as "IFSC Code"
				manager_name  as "Manager Name"
				branch_address  as "Branch Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				pincode as "Pincode"
				contact_number as "Contact Number"
				email_address as "Email Address"
				is_active as "Is Active"
				created_date as "Created Date"
			)
		}
		list co_applicant_Report
		{
			displayName = "Co Applicant Report"
			show all rows from co_applicant    
			(
				loan_application as "Loan Application"
				co_applicant_name as "Co Applicant Name"
				relationship as "Relationship"
				monthly_income as "Monthly Income"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (relationship == "Child")
				fields = [relationship]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (relationship == "Parent")
				fields = [relationship]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (relationship == "Sibling")
				fields = [relationship]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
				"New Formatting4"
				{
				condition = (relationship == "Spouse")
				fields = [relationship]
				format = "color:#ffffff;background-color:#3598db;"
				}
			)
		}
		kanban co_applicant_by_relationship
		{
			displayName = "Relationships"
			show all rows from co_applicant    
			(
				loan_application as "Loan Application"
				co_applicant_name as "Co Applicant Name"
				relationship as "Relationship"
				monthly_income as "Monthly Income"
			)
			options
			(
	 			display field = relationship
	 		)
		}
	}
	pages
	{
		page DashBoard
